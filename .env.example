# Free Scavio API key (250 credits/month, no card): https://dashboard.scavio.dev
# Used by every example -- Python, JS/TS, curl, and the recipes/ folders.
SCAVIO_API_KEY=sk-your-scavio-api-key

# Most LLM examples use OpenAI (gpt-4o / gpt-4o-mini). Swap for any model.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: only if you switch the LLM examples to Anthropic Claude.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
