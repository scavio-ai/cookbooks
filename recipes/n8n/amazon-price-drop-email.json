{
  "name": "Scavio - Amazon Price Drop Email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 9 }
          ]
        }
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Daily at 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "amazon",
        "operation": "search",
        "query": "sony wh-1000xm5",
        "additionalOptions": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Scavio Amazon Search",
      "type": "n8n-nodes-scavio.scavio",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "scavioApi": { "id": "1", "name": "Scavio account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "cheapest",
              "type": "number",
              "value": "={{ ($json.data.products || []).filter(p => p.price > 0).sort((a,b)=>a.price-b.price)[0].price }}"
            },
            {
              "id": "f2",
              "name": "title",
              "type": "string",
              "value": "={{ ($json.data.products || []).filter(p => p.price > 0).sort((a,b)=>a.price-b.price)[0].title }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "Pick Cheapest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.cheapest }}",
              "rightValue": 300,
              "operator": { "type": "number", "operation": "lte" }
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Below target?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "fromEmail": "alerts@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ 'Price drop: ' + $json.title + ' is $' + $json.cheapest }}",
        "emailFormat": "text",
        "text": "={{ $json.title + ' dropped to $' + $json.cheapest + ' (target $300).' }}",
        "options": {}
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 200]
    }
  ],
  "connections": {
    "Daily at 9am": {
      "main": [[{ "node": "Scavio Amazon Search", "type": "main", "index": 0 }]]
    },
    "Scavio Amazon Search": {
      "main": [[{ "node": "Pick Cheapest", "type": "main", "index": 0 }]]
    },
    "Pick Cheapest": {
      "main": [[{ "node": "Below target?", "type": "main", "index": 0 }]]
    },
    "Below target?": {
      "main": [
        [{ "node": "Send Email", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Checks an Amazon product price daily via the Scavio node, picks the cheapest in-stock match, and emails you when it falls to or below your target. Add Scavio API + SMTP credentials and set the target. A free price-tracker alternative."
  }
}
